# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/skillnav?schema=public"

# App
NODE_ENV="development"

# Secreto que firma las cookies de sesion. OBLIGATORIO en produccion: si falta,
# el build se detiene antes de publicar nada. Generar uno al azar en vez de
# escribirlo a mano, porque de su entropia depende que nadie pueda fabricarse
# la cookie de otra cuenta:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NO subir el valor real al repositorio.
SESSION_SECRET="cambia-esto-por-un-secreto-largo"

# Analisis de hoja de vida con IA (HU-22). Es OPCIONAL: sin clave el sistema
# usa el analisis por reglas y sigue funcionando igual.
# LLM_PROVIDER: "groq" (por defecto) o "gemini". Ambos tienen capa gratuita.
# LLM_PROVIDER="groq"
# LLM_API_KEY=""
# LLM_MODEL=""            # opcional: cada proveedor trae uno por defecto
# LLM_TIMEOUT_MS="20000"   # tras este tiempo cae al analisis por reglas
