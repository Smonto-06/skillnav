// Prisma schema para SkillNav
// Modela el nucleo del 60%: perfil de candidato, preferencias, vacantes y postulaciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidato {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  /// Rol de la cuenta (HU-25). Las cuentas existentes quedan como CANDIDATO.
  rol            Rol           @default(CANDIDATO)
  nombre         String?
  ciudad         String?
  contacto       String?
  disponibilidad String?
  /// Titular profesional, p. ej. "Desarrollador Full Stack". Define el rol en el scoring.
  titular        String?
  /// Resumen o perfil profesional (2-5 líneas).
  resumen        String?
  linkedin       String?
  nivelIngles    NivelIdioma?
  educacion      Educacion[]
  experiencia    Experiencia[]
  habilidades    Habilidad[]
  preferencia    Preferencia?
  borradorCV     BorradorCV?
  postulaciones  Postulacion[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// HU-23 · Borrador de lo que el parser detectó en el CV, pendiente de que el
/// candidato lo confirme. Se guarda aparte del perfil a propósito: hasta que
/// el candidato revise, son datos inferidos y no datos suyos.
model BorradorCV {
  id          String    @id @default(cuid())
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId String    @unique
  /// Nombre del archivo subido, para que el candidato sepa de dónde viene.
  archivo     String
  /// PerfilExtraido serializado (campos con su confianza y evidencia).
  datos       Json
  createdAt   DateTime  @default(now())
}

model Educacion {
  id          String          @id @default(cuid())
  candidato   Candidato       @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId String
  institucion String
  titulo      String
  anio        Int?
  nivel       NivelEducativo?
  enCurso     Boolean         @default(false)
}

model Experiencia {
  id          String    @id @default(cuid())
  candidato   Candidato @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId String
  empresa     String
  cargo       String
  fechaInicio DateTime?
  fechaFin    DateTime?
  /// Cargo actual: el tiempo se cuenta hasta hoy.
  actual      Boolean   @default(false)
  descripcion String?
}

model Habilidad {
  id          String          @id @default(cuid())
  candidato   Candidato       @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId String
  nombre      String
  tipo        TipoHabilidad   @default(TECNICA)
  nivel       NivelHabilidad?
  /// Años de experiencia usando la habilidad.
  anios       Int?
}

model Preferencia {
  id             String     @id @default(cuid())
  candidato      Candidato  @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId    String     @unique
  salarioMin     Int?
  salarioMax     Int?
  modalidad      Modalidad?
  ubicacion      String?
  disponibilidad String?
}

model Vacante {
  id             String        @id @default(cuid())
  titulo         String
  empresa        String
  descripcion    String?
  requisitos     String?
  /// Años de experiencia mínimos que pide la vacante.
  experienciaMin Int?
  salario        Int?
  modalidad      Modalidad?
  ciudad         String?
  postulaciones  Postulacion[]
  createdAt      DateTime      @default(now())
}

model Postulacion {
  id          String            @id @default(cuid())
  candidato   Candidato         @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  candidatoId String
  vacante     Vacante           @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
  vacanteId   String
  estado      EstadoPostulacion @default(POSTULADO)
  fecha       DateTime          @default(now())
}

enum Rol {
  CANDIDATO
  ADMIN
}

enum TipoHabilidad {
  TECNICA
  BLANDA
}

enum Modalidad {
  PRESENCIAL
  REMOTO
  HIBRIDO
}

enum EstadoPostulacion {
  POSTULADO
  EN_REVISION
  ENTREVISTA
  OFERTA
  DESCARTADO
}

enum NivelHabilidad {
  BASICO
  INTERMEDIO
  AVANZADO
  EXPERTO
}

enum NivelEducativo {
  BACHILLER
  CURSO
  CERTIFICACION
  DIPLOMADO
  BOOTCAMP
  TECNICO
  TECNOLOGO
  PROFESIONAL
  ESPECIALIZACION
  MAESTRIA
  DOCTORADO
}

enum NivelIdioma {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVO
}

/// HU-27 · Pesos del motor de scoring, configurables por el administrador.
/// Una sola fila: `id` fijo en 1 para que no puedan existir dos configuraciones
/// vigentes al mismo tiempo.
model ConfiguracionScoring {
  id          Int      @id @default(1)
  skills      Float    @default(0.40)
  rol         Float    @default(0.20)
  experiencia Float    @default(0.15)
  salario     Float    @default(0.10)
  modalidad   Float    @default(0.10)
  ubicacion   Float    @default(0.05)
  /// Quién hizo el último cambio y cuándo, para poder auditarlo.
  editadoPor  String?
  updatedAt   DateTime @updatedAt
}

/// HU-28 · Registro de cada recálculo masivo de scores.
/// Guarda el conteo y los errores para que el administrador vea qué pasó, en
/// lugar de un proceso que corre en silencio.
model EjecucionRecalculo {
  id             String   @id @default(cuid())
  ejecutadoPor   String
  perfiles       Int
  vacantes       Int
  paresEvaluados Int
  errores        Int
  duracionMs     Int
  /// Mensajes de los errores encontrados, para poder diagnosticarlos.
  detalleErrores Json?
  createdAt      DateTime @default(now())
}
